# Safety defaults to true. Set false only for an isolated test amoCRM account.
AMOCRM_READ_ONLY=true
AMOCRM_BASE_URL=https://example.amocrm.ru
AMOCRM_ACCESS_TOKEN=

# Issued separately by amoCRM support after Chats API channel registration.
AMOCRM_CHATS_BASE_URL=https://amojo.amocrm.ru
AMOCRM_CHATS_CHANNEL_ID=
AMOCRM_CHATS_CHANNEL_SECRET=
AMOCRM_CHATS_SCOPE_ID=
AMOCRM_CHATS_WEBHOOK_SECRET=

DATABASE_URL=postgresql://user:password@localhost:5432/messenger_bridge
PORT=3000
LOG_LEVEL=info

# Telegram user API (my.telegram.org); one encrypted session per account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=

# Meta WhatsApp Business Platform / Cloud API.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Official MAX Bot API only (not a personal MAX account).
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
