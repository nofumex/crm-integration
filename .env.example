# Current production amoCRM must stay true. Use false only in a separate test account environment.
AMOCRM_READ_ONLY=true
AMOCRM_ENVIRONMENT=production
AMOCRM_BASE_URL=https://test-account.amocrm.ru
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
AMOCRM_INTEGRATION_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://bridge.example/oauth/callback
AMOCRM_TOKEN_EXPIRES_AT=
AMOCRM_CHATS_BASE_URL=https://amojo.amocrm.ru
AMOCRM_CHATS_CHANNEL_ID=
AMOCRM_CHATS_CHANNEL_SECRET=

DATABASE_URL=postgresql://bridge:password@localhost:5432/messenger_bridge
SECRET_MASTER_KEY=
ADMIN_API_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

S3_ENDPOINT=https://s3.example.com
S3_REGION=ru-1
S3_BUCKET=crm-messenger-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_URL_TTL_SECONDS=86400
MEDIA_MAX_BYTES=26214400
MEDIA_ALLOWED_HOSTS=amojo.amocrm.ru,amojo.amocrm.com
MEDIA_DOWNLOAD_TIMEOUT_MS=15000
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

PORT=3000
LOG_LEVEL=info
WEBHOOK_BODY_LIMIT_BYTES=2097152
WEBHOOK_RATE_LIMIT_PER_MINUTE=300
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=60000
WORKER_POLL_MS=250
SHUTDOWN_TIMEOUT_MS=30000

# Messenger credentials are added through the authenticated admin onboarding API and
# encrypted in PostgreSQL; there are intentionally no global Telegram/WhatsApp/MAX tokens.
