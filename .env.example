# Current production amoCRM must stay true. Future write deployments require all three write-gate values below and exact startup identity verification.
AMOCRM_READ_ONLY=true
AMOCRM_ENVIRONMENT=production
AMOCRM_WRITES_ENABLED=false
AMOCRM_EXPECTED_ACCOUNT_ID=
AMOCRM_EXPECTED_SUBDOMAIN=
AMOCRM_BASE_URL=https://test-account.amocrm.ru
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
AMOCRM_INTEGRATION_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://bridge.example/oauth/callback
AMOCRM_TOKEN_EXPIRES_AT=
# OAuth stays on the legacy External Integration unless explicitly switched.
# The Private tokens are stored under amocrm:private:<integration-id> in SecretStore.
AMOCRM_OAUTH_PROFILE=legacy
AMOCRM_PRIVATE_INTEGRATION_ID=
AMOCRM_PRIVATE_CLIENT_SECRET=
AMOCRM_PRIVATE_REDIRECT_URI=https://bridge.example/oauth/callback
# Explicitly permits only Sources API mutations; general amoCRM writes remain separately gated.
AMOCRM_SOURCES_WRITES_ENABLED=false
AMOCRM_CHATS_ORIGIN_CODE=
AMOCRM_CHATS_BASE_URL=https://amojo.amocrm.ru
AMOCRM_CHATS_CHANNEL_ID=
AMOCRM_CHATS_CHANNEL_SECRET=
AMOCRM_CONTACT_TELEGRAM_USERNAME_FIELD_ID=
AMOCRM_CONTACT_TELEGRAM_ID_FIELD_ID=
AMOCRM_CONTACT_TELEGRAM_NAME_FIELD_ID=

# Defaults used for every new Telegram onboarding
AMOCRM_DEFAULT_ACCOUNT_ID=
AMOCRM_DEFAULT_SOURCE_EXTERNAL_ID=telegram-main
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Public HTTPS domain (used by Caddy and webhook URL in /admin)
PUBLIC_DOMAIN=bridge.example.com

DATABASE_URL=postgresql://bridge:password@localhost:5432/messenger_bridge
SECRET_MASTER_KEY=
ADMIN_API_TOKEN=

S3_ENDPOINT=https://s3.example.com
S3_REGION=ru-1
S3_BUCKET=crm-messenger-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_URL_TTL_SECONDS=86400
MEDIA_MAX_BYTES=26214400
# Exact trusted download origins only. Extend after observing documented provider URLs in test E2E.
MEDIA_ALLOWED_HOSTS=amojo.amocrm.ru,amojo.amocrm.com
MEDIA_DOWNLOAD_TIMEOUT_MS=15000
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

PORT=3000
LOG_LEVEL=info
WEBHOOK_BODY_LIMIT_BYTES=2097152
WEBHOOK_RATE_LIMIT_PER_MINUTE=300
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=60000
WORKER_POLL_MS=250
WORKER_INFRA_RETRY_MS=1000
# Only completed jobs are scrubbed after this period. Dead jobs retain payload until DEAD_JOB_RETENTION_DAYS.
COMPLETED_JOB_PAYLOAD_RETENTION_HOURS=24
JOB_RETENTION_DAYS=30
DEAD_JOB_RETENTION_DAYS=90
JOB_CLEANUP_INTERVAL_MS=3600000
SHUTDOWN_TIMEOUT_MS=30000

# Telegram api_id/api_hash and the amoCRM source external_id are global .env settings.
# Only each account's MTProto session is encrypted in PostgreSQL.
