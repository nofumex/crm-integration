# Docker Compose infrastructure (generated / copied into .env on VPS)

POSTGRES_USER=bridge
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=messenger_bridge

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-minio-password

# Public domain pointing to VPS (155.212.217.115)
PUBLIC_DOMAIN=sinaichannel.ru
ACME_EMAIL=admin@bridge.example.com

# amoCRM — start without channel credentials; add after amoCRM registration
AMOCRM_READ_ONLY=true
AMOCRM_ENVIRONMENT=production
AMOCRM_WRITES_ENABLED=false
AMOCRM_EXPECTED_ACCOUNT_ID=
AMOCRM_EXPECTED_SUBDOMAIN=
AMOCRM_BASE_URL=https://your-account.amocrm.ru
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
AMOCRM_INTEGRATION_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://sinaichannel.ru/oauth/callback
AMOCRM_TOKEN_EXPIRES_AT=
AMOCRM_CHATS_BASE_URL=https://amojo.amocrm.ru
AMOCRM_CHATS_CHANNEL_ID=
AMOCRM_CHATS_CHANNEL_SECRET=

# Defaults for /admin wizard (Telegram credentials go via UI → SecretStore)
AMOCRM_DEFAULT_ACCOUNT_ID=
AMOCRM_DEFAULT_SOURCE_EXTERNAL_ID=telegram-main

DATABASE_URL=postgresql://bridge:change-me-strong-postgres-password@postgres:5432/messenger_bridge
SECRET_MASTER_KEY=generate-32-plus-char-random-string-here
ADMIN_API_TOKEN=generate-32-plus-char-random-token-here

S3_ENDPOINT=http://minio:9000
S3_REGION=ru-1
S3_BUCKET=crm-messenger-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-strong-minio-password
S3_FORCE_PATH_STYLE=true
MEDIA_URL_TTL_SECONDS=86400
MEDIA_MAX_BYTES=26214400
MEDIA_ALLOWED_HOSTS=amojo.amocrm.ru,amojo.amocrm.com
MEDIA_DOWNLOAD_TIMEOUT_MS=15000
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

PORT=3000
LOG_LEVEL=info
WEBHOOK_BODY_LIMIT_BYTES=2097152
WEBHOOK_RATE_LIMIT_PER_MINUTE=300
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=60000
WORKER_POLL_MS=250
WORKER_INFRA_RETRY_MS=1000
COMPLETED_JOB_PAYLOAD_RETENTION_HOURS=24
JOB_RETENTION_DAYS=30
DEAD_JOB_RETENTION_DAYS=90
JOB_CLEANUP_INTERVAL_MS=3600000
SHUTDOWN_TIMEOUT_MS=30000
